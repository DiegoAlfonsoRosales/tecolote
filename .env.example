# Contraseña para entrar a la app (la sesión no expira en tu celular)
APP_PASSWORD=cambia-esta-contraseña

# Tema de ntfy: que sea difícil de adivinar, cualquiera que lo sepa puede leer tus avisos
NTFY_TOPIC=tecolote-cambia-esto
NTFY_SERVER=https://ntfy.sh

# Dirección pública de la app (se usa en los botones de la notificación)
PUBLIC_URL=https://tecolote.theowlsec.com

# Opcionales
# QUIET_START=0      # inicio del silencio (0 = 12 am)
# QUIET_END=6        # fin del silencio (6 = 6 am)
# WAKE_HOUR=7        # hora en que despiertas: desde aquí se recuerdan las rutinas
# DAILY_HOUR=9       # hora del aviso diario para pendientes lejanos
# REMIND_EVERY=15    # minutos entre avisos el día límite y en rutinas
# OVERDUE_EVERY=30   # minutos entre avisos de pendientes vencidos
# MED_PRE_MIN=10     # aviso previo de medicinas (min)
# MED_NAG_MIN=5      # insistencia de medicinas (min)
# MED_GRACE_MIN=60   # tolerancia antes de "no registraste tu toma" (min)
